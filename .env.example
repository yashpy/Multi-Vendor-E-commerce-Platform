# Server
PORT=8080
NODE_ENV=development

# PostgreSQL / Cloud SQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce
# When deployed on Cloud SQL via Unix socket:
# DATABASE_URL=postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Firestore
FIRESTORE_EMULATOR_HOST=localhost:8081

# BigQuery
BQ_DATASET=ecommerce_analytics

# Analytics publisher
ANALYTICS_PUBLISHER_MODE=local
